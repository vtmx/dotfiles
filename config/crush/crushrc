# Global dir
option data-directory $HOME/.local/share/crush

# Ativa o modo compacto para reduzir o envio de lixo no payload
option ui compact true

# Não exibr logo ao sair
option ui exit-banner none

# Providers
provider add groq \
  --name "GPT OSS 120B" \
  --type openai \
  --base-url "https://api.groq.com/openai/v1" \
  --api-key "$GROQ_API_KEY"

# Models
model add groq/openai/gpt-oss-120b \
  --default-max-tokens 2048


has() {
  command -v "$1" &> /dev/null
}

# https://donottrack.sh
export DO_NOT_TRACK=1

# bat
if has bat; then
  export BAT_THEME="ansi"
  export BAT_STYLE="numbers,changes,header"
fi

# bemenu
if has bemenu; then
  export BEMENU_OPTS="
    -c -l 10 -W 0.3 -B 1 -p '' \
    --fn 'BlexMono Nerd Font 11' \
    --tb  '#1e2227' --tf  '#abb2bf' \
    --fb  '#1e2227' --ff  '#abb2bf' \
    --nb  '#1e2227' --nf  '#abb2bf' \
    --ab  '#1e2227' --af  '#abb2bf' \
    --hb  '#3d4556' --hf  '#abb2bf' \
    --sb  '#61afef' --sf  '#3d4556' \
    --bdr '#2c313c'"
fi

# carapace
if has carapace; then
  source <(carapace _carapace bash)
fi

if has crush; then
  export CRUSH_DISABLE_METRICS=1
fi

# fzf
if has fzf; then
  if [[ -f /usr/share/fzf/completion.bash ]]; then
    source /usr/share/fzf/completion.bash
  fi

  if [[ -f /usr/share/fzf/key-bindings.bash ]]; then
    source /usr/share/fzf/key-bindings.bash
  fi

  fzf_args="
    --height 50% --reverse --separator=''
    --border=none --preview-window=''
    --color=bg:-1,fg:-1,hl:blue
    --color=bg+:blue,fg+:0,hl+:black
    --color=prompt:green,marker:blue,pointer:black
    --color=spinner:-1,border:black,gutter:black
    --color=header:-1,info:-1
  "

  if [[ $DISPLAY ]]; then
    export FZF_DEFAULT_OPTS="$fzf_args
    --prompt '❯ ' --marker '❯' --pointer '❯'"
  else
    export FZF_DEFAULT_OPTS="$fzf_args
    --prompt '> ' --marker '>' --pointer '>'"
  fi
fi

# fd
if has fd; then
  export LS_COLORS=''
fi

# go
if has go; then
  export GODEBUG=gotelemetry=0
  export GOPATH=$HOME/Dev/go
  export PATH=$PATH:$GOPATH/bin
fi

# gum
if has gum; then
  # choose
  export GUM_CHOOSE_CURSOR='❯ '
  export GUM_CHOOSE_CURSOR_FOREGROUND=7
  export GUM_CHOOSE_CURSOR_BACKGROUND='#3d4556'
  export GUM_CHOOSE_HEADER=''
  export GUM_CHOOSE_HEADER_FOREGROUND=7
  export GUM_CHOOSE_HEADER_BACKGROUND=0
  export GUM_CHOOSE_ITEM_FOREGROUND=7
  export GUM_CHOOSE_ITEM_BACKGROUND=0
  export GUM_CHOOSE_SELECTED_FOREGROUND=4
  export GUM_CHOOSE_SELECTED_BACKGROUND=0
  export GUM_CHOOSE_PADDING='0'

  # confirm
  export GUM_CONFIRM_PROMPT_FOREGROUND=7
  export GUM_CONFIRM_PROMPT_BACKGROUND=0
  export GUM_CONFIRM_SELECTED_FOREGROUND=0
  export GUM_CONFIRM_SELECTED_BACKGROUND=4
  export GUM_CONFIRM_UNSELECTED_FOREGROUND=7
  export GUM_CONFIRM_UNSELECTED_BACKGROUND='#3d4556'

  # input
  export GUM_INPUT_CURSOR_FOREGROUND=7
  export GUM_INPUT_PROMPT_FOREGROUND=7
  export GUM_INPUT_PLACEHOLDER=''
  export GUM_INPUT_PROMPT=''
  export GUM_INPUT_WIDTH=80

  # pager
  export GUM_PAGER_FOREGROUND=7
  export GUM_PAGER_BACKGROUND=red
  export GUM_PAGER_LINE_NUMBER_FOREGROUND=7
  export GUM_PAGER_LINE_NUMBER_BACKGROUND=0
  export GUM_PAGER_MATCH_FOREGROUND=0
  export GUM_PAGER_MATCH_BACKGROUND=7
  export GUM_PAGER_MATCH_HIGH_FOREGROUND=0
  export GUM_PAGER_MATCH_HIGH_BACKGROUND=4
  export GUM_PAGER_HELP_FOREGROUND=7
  export GUM_PAGER_HELP_BACKGROUND=0
  export GUM_PAGER_BORDER='none'
fi

# nvm
if has nvm; then
  export NVM_DIR=$HOME/.nvm
  [[ -s $NVM_DIR/nvm.sh ]] && \. $NVM_DIR/nvm.sh
fi

# opencode
if has opencode; then
  export OPENCODE_ENABLE_EXA=1
fi

# zot
if has zot; then
  export ZOT_HOME="$HOME/.config/zot"
fi

# zoxide
if has zoxide; then
  eval "$(zoxide init bash)"
fi

